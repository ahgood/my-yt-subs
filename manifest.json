{
  "name": "My YT Subscriptions",
  "description": "Search your YouTube subscriptions from an on-page overlay, star your favorites, and open any channel in seconds.",
  "version": "1.2.2",
  "manifest_version": 3,
  "action": {
    "default_title": "My YT Subscriptions"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["overlay.html"],
      "matches": ["https://www.youtube.com/*"]
    }
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
